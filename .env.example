# Optional: copy to .env so you don't have to paste keys into the page.
OPENROUTER_API_KEY=
# Optional: faster, more reliable paper verification (https://www.semanticscholar.org/product/api)
SEMANTIC_SCHOLAR_API_KEY=
# Optional: backup paper database; a free key raises the daily limit (https://openalex.org/settings/api)
OPENALEX_API_KEY=
# Optional: local models through Ollama (use model names like ollama/qwen3:14b)
OLLAMA_URL=http://127.0.0.1:11434
# Optional: largest context window requested from local models (raise it if your GPU/RAM allows)
OLLAMA_NUM_CTX=32768
